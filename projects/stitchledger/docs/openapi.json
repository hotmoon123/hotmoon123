  "components": {
    "schemas": {
      "ChangeStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Booked",
              "Cutting",
              "Sewing",
              "Ready",
              "Collected",
              "Cancelled"
            ],
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "ChangeStatus"
      },
      "Consent": {
        "properties": {
          "consent": {
            "type": "boolean",
            "const": true,
            "title": "Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "consent"
        ],
        "title": "Consent"
      },
      "CreateOrder": {
        "properties": {
          "customer": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Customer"
          },
          "garment": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Garment"
          },
          "due": {
            "type": "string",
            "format": "date",
            "title": "Due"
          },
          "total": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          },
          "deposit": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Deposit",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer",
          "garment",
          "due",
          "total"
        ],
        "title": "CreateOrder"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DeleteAccount": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "confirmation": {
            "type": "string",
            "const": "DELETE",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password",
          "confirmation"
        ],
        "title": "DeleteAccount"
      },
      "EditOrder": {
        "properties": {
          "customer": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Customer"
          },
          "garment": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Garment"
          },
          "due": {
            "type": "string",
            "format": "date",
            "title": "Due"
          },
          "total": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Total"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer",
          "garment",
          "due",
          "total",
          "version"
        ],
        "title": "EditOrder"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Payment": {
        "properties": {
          "amount": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "refund"
            ],
            "title": "Kind",
            "default": "receipt"
          },
          "method": {
            "type": "string",
            "enum": [
              "Cash",
              "MoMo",
              "Bank"
            ],
            "title": "Method",
            "default": "Cash"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "note"
        ],
        "title": "Payment"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "studio": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Studio"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "studio"
        ],
        "title": "Register"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
