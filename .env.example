# Rent & Lease Management System — Environment Variables Template
# Copy to .env and fill in your values

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# XAMPP / LAMPP (MySQL or MariaDB): start MySQL from the control panel, then create a database
# (phpMyAdmin → New → name e.g. rent_lease_db → Collation utf8mb4_unicode_ci), or run:
#   /opt/lampp/bin/mysql -u root -e "CREATE DATABASE rent_lease_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# Windows XAMPP: use shell in xampp/mysql/bin or HeidiSQL / phpMyAdmin the same way.

# MySQL (recommended when using XAMPP / LAMPP)
DB_ENGINE=django.db.backends.mysql
DB_NAME=rent_lease_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# If Django cannot connect on TCP, use the LAMPP socket (leave empty to use TCP only):
# DB_SOCKET=/opt/lampp/var/mysql/mysql.sock

# SQLite (no MySQL needed — uncomment these and comment the MySQL block above)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:8000

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
